{
  "schemaVersion": 1,
  "name": "test-net",
  "networks": {
    "frontend": {},
    "backend": {}
  },
  "services": {
    "db": {
      "configPresent": true,
      "volumes": [
        { "type": "disk", "name": "db-data", "target": "/var/lib/postgresql", "size": "2G" }
      ],
      "networks": [ { "name": "backend", "addr": "fd00:1234:5678::2" } ],
      "ports": [ "5432:5432" ]
    },
    "web": {
      "configPresent": true,
      "dependsOn": [ "db" ],
      "networks": [
        { "name": "backend", "addr": "fd00:1234:5678::3" },
        { "name": "frontend", "addr": "fd00:1234:5678::3" }
      ],
      "ports": [ "8080:80" ]
    },
    "jump": {
      "configPresent": true,
      "networks": [
        { "name": "frontend" },
        { "name": "backend" }
      ]
    }
  },
  "rules": [
    { "from": "web", "to": "db", "ports": [5432] }
  ]
}
